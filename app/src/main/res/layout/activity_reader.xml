<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EA">

    <com.moyue.reader.ui.ReaderView
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部工具条 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FAF7F2"
        android:elevation="3dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="#6B6055"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/top_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#241F1A"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/top_chapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#9C9184"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_bookmark"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bookmark"
            android:tint="#6B6055"
            android:contentDescription="书签" />
    </LinearLayout>

    <!-- 底部工具条 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="#FAF7F2"
        android:elevation="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9C9184"
                android:textSize="11sp"
                android:minWidth="54dp"
                android:text="1 / 1" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="#B87333"
                android:progressBackgroundTint="#33000000"
                android:thumbTint="#B87333" />

            <TextView
                android:id="@+id/tv_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9C9184"
                android:textSize="11sp"
                android:minWidth="44dp"
                android:gravity="end"
                android:text="0%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/btn_toc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_toc"
                    android:tint="#6B6055"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="目录"
                    android:textColor="#6B6055"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_speak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_speaker"
                    android:tint="#6B6055"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_speak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="朗读"
                    android:textColor="#6B6055"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/ic_settings"
                    android:tint="#6B6055"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="排版"
                    android:textColor="#6B6055"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 悬浮朗读控制条：朗读时常驻，停止要一眼能找到，不用长按翻菜单 -->
    <LinearLayout
        android:id="@+id/speech_bar"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_speech_bar"
        android:elevation="8dp"
        android:paddingStart="13dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <View
            android:id="@+id/speech_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/dot_live" />

        <TextView
            android:id="@+id/tv_speech_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朗读中"
            android:textColor="#6B6055"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_speech_toggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="暂停"
            android:textColor="#96571F"
            android:textSize="12.5sp" />

        <View
            android:layout_width="0.8dp"
            android:layout_height="13dp"
            android:background="#1F000000" />

        <TextView
            android:id="@+id/btn_speech_stop"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="停止"
            android:textColor="#8A7E70"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 遮罩 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1E140A"
        android:visibility="gone" />

    <!-- 目录抽屉 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFDF9"
        android:elevation="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/drawer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="目录"
                android:textColor="#241F1A"
                android:textSize="17sp"
                android:fontFamily="serif"
                android:letterSpacing="0.05" />

            <ImageButton
                android:id="@+id/drawer_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="#9C9184"
                android:rotation="180"
                android:contentDescription="关闭" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#1A3C2D1E" />

        <ListView
            android:id="@+id/toc_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- 排版设置面板 -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFDF9"
        android:elevation="16dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="#26000000" />

        <!-- 字号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字号"
                android:textColor="#6B6055"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btn_font_minus"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="A-"
                android:textColor="#241F1A"
                android:textSize="15sp"
                android:background="#F0EADF" />

            <TextView
                android:id="@+id/tv_font_size"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="19"
                android:textColor="#241F1A"
                android:textSize="13sp"
                android:background="#F0EADF" />

            <TextView
                android:id="@+id/btn_font_plus"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="A+"
                android:textColor="#241F1A"
                android:textSize="15sp"
                android:background="#F0EADF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 行距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行距"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sp_tight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="紧凑"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sp_normal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="适中"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sp_loose"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="宽松"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 字体 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字体"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/font_serif"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="宋体"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/font_sans"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="黑体"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 主题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背景"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/theme_paper"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="纸"
                    android:textSize="12sp"
                    android:textColor="#3C2D1E"
                    android:background="#F6F2EA"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/theme_white"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="白"
                    android:textSize="12sp"
                    android:textColor="#1A1A1A"
                    android:background="#FFFFFF"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/theme_sepia"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="黄"
                    android:textSize="12sp"
                    android:textColor="#3A2F20"
                    android:background="#F2E8D5"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/theme_night"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="夜"
                    android:textSize="12sp"
                    android:textColor="#C9BFB2"
                    android:background="#14110E" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 纸张纹理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="纸张纹理"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tex_none"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="无"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tex_wood"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="木纹"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tex_linen"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="亚麻"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tex_leather"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="皮革"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tex_marble"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="石纹"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tex_antique"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="旧纸"
                    android:textSize="11.5sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 边距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="页边距"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mg_narrow"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="窄"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/mg_mid"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="中"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/mg_wide"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="宽"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.8dp" android:background="#143C2D1E" />

        <!-- 翻页效果 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="翻页效果"
                android:textColor="#6B6055"
                android:textSize="12.5sp"
                android:layout_marginBottom="9dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/turn_fold"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="翻书"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/turn_slide"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="滑动"
                    android:textSize="13sp"
                    android:textColor="#6B6055"
                    android:background="#F0EADF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
